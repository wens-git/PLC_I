(* 现场运行配置。全部为工程常量，不允许经 Modbus 写入。
   这些开关对应原程序 全局变量_系统 中的同名工程开关，语义保持不变：
   任何一项在被现场核验前保持 FALSE / 安全侧默认值。 *)
VAR_GLOBAL CONSTANT
    (* 正式工艺 POU 接入并完成评审后才允许改为 TRUE。
       为 FALSE 时命令 2（整机启动）被拒绝为 12，与原程序
       “NOT b正式流程已接入 → 拒绝” 的既有约定一致。 *)
    b正式流程已接入 : BOOL := FALSE;

    (* X0 启动 / X1 暂停 / X2 复位 的硬件去抖时间，原程序为 20 ms。
       急停 X3 不滤波：安全输入不进延时链。 *)
    di输入滤波时间ms : DINT := 20;

    (* 输出映像容量。只发布已实测的 Y6/Y7 两路，不得按逻辑槽数推断。 *)
    ui物理输出点数 : UINT := 2;

    (* 暂停后恢复允许的位置偏差，单位与轴位置一致（0.001 工程单位）。
       超过该值不阻止恢复，但会在恢复后由本块下发回位定位。 *)
    di暂停恢复容差 : DINT := 30;

    (* 暂停后确认静止的时间，原程序为 300 ms。停稳后才抓拍快照，
       减速距离不计入偏离。 *)
    di暂停停稳ms : DINT := 300;
END_VAR
