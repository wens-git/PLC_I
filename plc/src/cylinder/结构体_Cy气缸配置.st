(* 单缸配置：一行描述一个气缸的阀型、两侧绑定和确认方式。
   点地址是物理映像内的序号（输出 0..55，输入 0..111），不是 %QX/%IX 绝对地址。
   选择 Cy确认.延时 时省略对应 in 字段；out原点 仅双线圈/真空带破真空使用。 *)
TYPE 结构体_Cy气缸配置 :
STRUCT
    已绑定 : BOOL;
    e阀型 : Cy阀型 := Cy阀型.单线圈复位;

    out动点 : WORD := 65535;
    out原点 : WORD := 65535;

    e动点确认 : Cy确认 := Cy确认.延时;
    in动点 : WORD := 65535;

    e原点确认 : Cy确认 := Cy确认.延时;
    in原点 : WORD := 65535;

    动点反相 : BOOL;
    原点反相 : BOOL;
END_STRUCT
END_TYPE
