(* 单缸工程记录：一行描述一个气缸的接线和阀型。
   已绑定=FALSE 时其余字段被忽略。地址为映像点序号（0..111 输入 / 0..55 输出），
   65535 表示该路不存在。 *)
TYPE 结构体_气缸工程 :
STRUCT
    已绑定 : BOOL;
    类型 : BYTE;              (* 0单线圈 1双线圈 2真空 3真空+破真空 *)
    有动点传感器 : BOOL := TRUE;
    有原点传感器 : BOOL := TRUE;
    动点反相 : BOOL;
    原点反相 : BOOL;
    动点阀 : WORD := 65535;
    原点阀 : WORD := 65535;
    动点传感器 : WORD := 65535;
    原点传感器 : WORD := 65535;
END_STRUCT
END_TYPE
