(* 物理输入/输出边界：全工程只有本文件出现物理地址。
   信捷 HSIO 实测映射（与 HSIO 配置页、SDFCfg0 软元件配置对应）：
     一般输入：X0..X7、X10..X13（八进制编号，无 X8/X9）；
     一般输出：Y2、Y3、Y6、Y7、Y10..Y13；
     轴0：脉冲 Y0 / 方向 Y4；轴1：脉冲 Y1 / 方向 Y5；轴2/轴3 当前未启用。
   少量气缸直连模板（全接内建点，按现场接线改名/改地址；本文件是唯一地址来源）：
     CY00：动点开关 X5、原点开关 X6、动点阀 Y2、原点阀 Y3
     CY01：动点开关 X7、原点侧不接传感器（用延时确认）、动点阀 Y6、原点阀 Y7
   直连绑定行在 程序_气缸输入映射.st / 程序_气缸输出映射.st 末尾；
   扩展模块仍走 aw气缸输入映像/aw气缸输出映像（点号从 32 起），由设备树映射。
   维护规则：
     1) %IX/%QX 与端子丝印不完全对应（X10 以后按八进制推），改线必须同步更新本文件、
        docs/硬件IO对照表.md 与现场接线图；
     2) 轴2/轴3 若启用，方向端口为 Y6/Y7，会与本文件的 Y6/Y7 一般输出冲突；
     3) 急停 X3 只保证不进入软件滤波链；硬件滤波由 HSIO/SDFCfg 配置决定，
        安全响应仍由现场急停回路保证，本程序不是安全 PLC。 *)
VAR_GLOBAL
    b启动按钮 AT %IX0.0 : BOOL;   (* X0 启动，高有效 *)
    b暂停按钮 AT %IX0.1 : BOOL;   (* X1 暂停，高有效 *)
    b复位按钮 AT %IX0.2 : BOOL;   (* X2 复位，高有效 *)
    b急停按钮 AT %IX0.3 : BOOL;   (* X3 急停常开，TRUE=按下，断线不可诊断 *)
    b备用输入 AT %IX0.4 : BOOL;   (* X4 备用，高有效 *)

    (* ===== CY00 双电控（模板，按现场接线改名）===== *)
    bCY00_动点传感器 AT %IX0.5 : BOOL;  (* X5 动点开关 *)
    bCY00_原点传感器 AT %IX0.6 : BOOL;  (* X6 原点开关 *)
    bCY00_动点阀 AT %QX0.2 : BOOL;      (* Y2 动点阀 *)
    bCY00_原点阀 AT %QX0.3 : BOOL;      (* Y3 原点阀 *)

    (* ===== CY01 双电控，原点用时间确认（模板）===== *)
    bCY01_动点传感器 AT %IX0.7 : BOOL;  (* X7 动点开关 *)
    bCY01_动点阀 AT %QX0.6 : BOOL;      (* Y6 动点阀 *)
    bCY01_原点阀 AT %QX0.7 : BOOL;      (* Y7 原点阀 *)
END_VAR
