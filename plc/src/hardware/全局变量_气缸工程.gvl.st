(* 唯一气缸工程配置：一缸一行，读起来就是接线表。
   默认全部未绑定，不驱动任何现场输出。
   绑定示例：
       (已绑定 := TRUE, e阀型 := Cy阀型.双线圈保持,
        out动点 := 0, out原点 := 1,
        e动点确认 := Cy确认.传感器, in动点 := 0,
        e原点确认 := Cy确认.传感器, in原点 := 1),
   只用时间确认的推料缸：
       (已绑定 := TRUE, e阀型 := Cy阀型.单线圈复位, out动点 := 2) *)
VAR_GLOBAL CONSTANT
    Cy气缸配置 : ARRAY[0..53] OF 结构体_Cy气缸配置 := [
        54((已绑定 := FALSE))
    ];
END_VAR
