(* 唯一气缸工程配置：一缸一行，读起来就是接线表。
   默认全部未绑定，不驱动任何现场输出。
   点号 = 端子号（当前少量气缸全接内建点，直连模式）：
     in动点 := 5 就是 X5，out动点 := 2 就是 Y2；
   实际接线在 全局变量_物理IO.gvl.st 与 程序_气缸输入映射/输出映射.st，
   本表点号用于 HMI 显示与配置校验，必须和接线表一致。
   扩展模块缸的点号从 32 起，由设备树映射到 aw气缸输入/输出映像。
   示例（接好线后把 已绑定 改为 TRUE，并按实际核对点号/阀型/确认方式）：
       双电控夹紧缸：
       (已绑定 := TRUE, e阀型 := Cy阀型.双线圈保持,
        out动点 := 2, out原点 := 3,
        e动点确认 := Cy确认.传感器, in动点 := 5,
        e原点确认 := Cy确认.传感器, in原点 := 6),
       原点用时间确认的缸：e原点确认 := Cy确认.延时，省略 in原点。
       只用时间确认的推料缸：
       (已绑定 := TRUE, e阀型 := Cy阀型.单线圈复位, out动点 := 2) *)
VAR_GLOBAL CONSTANT
    Cy气缸配置 : ARRAY[0..53] OF 结构体_Cy气缸配置 := [
        (* CY00：X5/X6 传感器，Y2/Y3 阀；双电控。模板，未绑定 *)
        (已绑定 := FALSE, e阀型 := Cy阀型.双线圈保持,
         out动点 := 2, out原点 := 3,
         e动点确认 := Cy确认.传感器, in动点 := 5,
         e原点确认 := Cy确认.传感器, in原点 := 6),
        (* CY01：X7 动点传感器，原点延时确认，Y6/Y7 阀。模板，未绑定 *)
        (已绑定 := FALSE, e阀型 := Cy阀型.双线圈保持,
         out动点 := 6, out原点 := 7,
         e动点确认 := Cy确认.传感器, in动点 := 7,
         e原点确认 := Cy确认.延时),
        52((已绑定 := FALSE))
    ];
END_VAR
